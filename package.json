{
  "name": "invoice-reservation",
  "version": "0.1.0",
  "private": true,
  "description": "Program Capacity & Invoice Reservation",
  "engines": {
    "node": ">=22.0.0 <23"
  },
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:cov": "jest --coverage",
    "test:unit": "jest test/unit",
    "test:recovery": "jest --config jest.recovery.config.ts",
    "test:perf": "jest --config jest.perf.config.ts",
    "test:e2e": "jest --config jest.e2e.config.ts",
    "test:mutation": "stryker run stryker.config.mjs",
    "migration:run": "typeorm-ts-node-commonjs migration:run -d src/config/data-source.ts",
    "migration:revert": "typeorm-ts-node-commonjs migration:revert -d src/config/data-source.ts",
    "migration:generate": "typeorm-ts-node-commonjs migration:generate -d src/config/data-source.ts",
    "seed": "ts-node scripts/seed.ts",
    "audit:ledger": "ts-node scripts/audit-ledger.ts",
    "reconcile": "ts-node scripts/reconcile.ts",
    "docs:verify": "./scripts/verify-docs.sh",
    "openapi:export": "ts-node scripts/export-openapi.ts"
  },
  "dependencies": {
    "@nest-lab/throttler-storage-redis": "1.2.0",
    "@nestjs/common": "11.2.5",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.2.5",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/platform-express": "11.2.5",
    "@nestjs/schedule": "5.0.1",
    "@nestjs/swagger": "^11.4.7",
    "@nestjs/terminus": "11.1.1",
    "@nestjs/throttler": "6.7.0",
    "@nestjs/typeorm": "11.0.3",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "ioredis": "5.11.1",
    "joi": "18.2.9",
    "kafkajs": "2.2.4",
    "kafkajs-snappy": "1.1.0",
    "nestjs-pino": "5.2.0",
    "pg": "8.23.0",
    "pino-http": "11.0.0",
    "prom-client": "15.1.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "typeorm": "0.3.31"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.24",
    "@nestjs/schematics": "11.1.0",
    "@nestjs/testing": "11.2.5",
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/jest-runner": "10.0.0",
    "@stryker-mutator/typescript-checker": "10.0.0",
    "@testcontainers/postgresql": "12.1.0",
    "@testcontainers/redpanda": "12.1.0",
    "@types/express": "5.0.6",
    "@types/jest": "29.5.14",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "22.20.4",
    "@types/supertest": "7.2.1",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "eslint": "9.39.5",
    "eslint-plugin-boundaries": "7.2.0",
    "jest": "29.7.0",
    "js-yaml": "5.4.2",
    "jsonwebtoken": "9.0.3",
    "prettier": "3.9.8",
    "supertest": "7.2.2",
    "testcontainers": "12.1.0",
    "ts-jest": "29.4.12",
    "ts-node": "10.9.2",
    "typescript": "5.6.3",
    "typescript-eslint": "8.70.0"
  }
}
