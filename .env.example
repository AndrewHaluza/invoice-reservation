NODE_ENV=development
PORT=3000
API_DOCS_ENABLED=true

# The service connects as capacity_app, a member of app_role and NOT the table owner, so the
# ledger's REVOKE UPDATE, DELETE actually binds. Migrations run as the owning capacity role.
DATABASE_URL=postgresql://capacity_app:capacity_local_dev@localhost:5432/capacity
MIGRATION_DATABASE_URL=postgresql://capacity:capacity_local_dev@localhost:5432/capacity
REDIS_URL=redis://localhost:6379

KAFKA_BROKERS=localhost:9093
KAFKA_SASL_USERNAME=capacity
KAFKA_SASL_PASSWORD=capacity_local_dev
KAFKA_SASL_DISABLED=false
KAFKA_LAG_PROBE_ENABLED=true
KAFKA_CAPACITY_EVENTS_TOPIC=treasury.capacity.events
KAFKA_SNAPSHOTS_TOPIC=treasury.capacity.snapshots
KAFKA_DLQ_TOPIC=treasury.capacity.dlq
KAFKA_CONSUMER_GROUP_ID=capacity-treasury-consumer
KAFKA_RETRY_MAX_ATTEMPTS=5
KAFKA_RETRY_BASE_DELAY_MS=200
KAFKA_RETRY_MAX_DELAY_MS=10000

# Local development only. Obviously fake by construction — never a production secret.
JWT_SECRET=dev-only-not-a-real-secret-0000000000
JWT_CLOCK_SKEW_SECONDS=60

SNAPSHOT_DELTA_GUARD_RATIO=0.5
RATE_LIMIT_READ_PER_MINUTE=600
RATE_LIMIT_WRITE_PER_MINUTE=120
RECONCILIATION_INTERVAL_SECONDS=300
REQUEST_RETENTION_DAYS=30
